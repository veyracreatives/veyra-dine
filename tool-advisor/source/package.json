{
 "name": "veyra-tool-advisor",
 "version": "1.1.0",
 "description": "Veyra Tool Advisor",
 "main": "main.cjs",
 "scripts": {
  "test": "echo \"Error: no test specified\" && exit 1"
 },
 "keywords": [],
 "author": "Veyra Creatives",
 "license": "ISC",
 "dependencies": {
  "occt-import-js": "^0.0.23",
  "three": "^0.170.0"
 },
 "devDependencies": {
  "electron": "^33.2.1",
  "electron-builder": "^25.1.8",
  "pe-library": "^1.0.1",
  "resedit": "^2.0.3"
 },
 "build": {
  "appId": "com.veyra.tooladvisor",
  "productName": "Veyra Tool Advisor",
  "files": [
   "main.cjs",
   "preload.cjs",
   "ui/**/*",
   "build/icon.png"
  ],
  "directories": {
   "output": "dist"
  },
  "win": {
   "target": [
    {
     "target": "nsis",
     "arch": [
      "x64"
     ]
    }
   ],
   "icon": "build/icon.ico",
   "signAndEditExecutable": false
  },
  "nsis": {
   "oneClick": false,
   "allowToChangeInstallationDirectory": true,
   "perMachine": false,
   "createDesktopShortcut": true,
   "shortcutName": "Veyra Tool Advisor",
   "artifactName": "VeyraToolAdvisor-Setup-${version}.exe"
  },
  "fileAssociations": [
   {
    "ext": [
     "step",
     "stp",
     "igs",
     "iges"
    ],
    "name": "3D part",
    "role": "Viewer"
   }
  ]
 }
}
